# ReLiS runtime configuration — safe example values only.
# Every value below is a placeholder. Never commit real credentials.
# See README.md ("Runtime configuration") for the full variable reference,
# precedence rules, and which commands actually validate these values.

# Shared (apps/api, apps/worker)
NODE_ENV=development

# apps/api — @relis/config "api" schema
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# apps/web — @relis/config "web" (runtime) schema
WEB_PORT=3000

# apps/web — @relis/config "public" schema (browser-exposed; inlined into
# the client bundle at build time by Next.js's NEXT_PUBLIC_* convention)
NEXT_PUBLIC_API_URL=http://localhost:3001

# packages/database migration + tooling/scripts/deploy.mjs (control step)
# Required whenever the control migration runs: `pnpm --filter @relis/database
# run migrate control`, or deploy.mjs unless run with --skip-migrate.
# packages/database/prisma/control/schema.prisma defines no models yet.
CONTROL_DATABASE_URL=postgresql://relis:changeme@localhost:5432/relis_control

# packages/database migration (project target) — only required when
# migrating a specific project database directly:
# `pnpm --filter @relis/database run migrate project`. No automated
# process supplies this today; per-project provisioning is out of scope.
# packages/database/prisma/project/schema.prisma defines no models yet.
PROJECT_DATABASE_URL=postgresql://relis:changeme@localhost:5432/relis_project_example
