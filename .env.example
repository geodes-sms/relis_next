# ReLiS runtime configuration — safe example values only.
# Every value below is a placeholder. Never commit real credentials.
# See README.md ("Runtime configuration") for the full variable reference,
# precedence rules, and which commands actually validate these values.

# Shared (apps/api, apps/worker)
NODE_ENV=development

# apps/api — @relis/config "api" schema
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# apps/web — @relis/config "web" (runtime) schema
WEB_PORT=3000

# apps/web — @relis/config "public" schema (browser-exposed; inlined into
# the client bundle at build time by Next.js's NEXT_PUBLIC_* convention).
# This value is for running apps/web NATIVELY (outside Docker Compose).
# Inside Compose, docker-compose.yml sets its own literal
# NEXT_PUBLIC_API_URL (http://localhost:${NGINX_HTTP_PORT}/api, through
# the nginx proxy) directly on the `web` service — it does not read this
# line. See docs/architecture/docker-compose-stack.md.
NEXT_PUBLIC_API_URL=http://localhost:3001

# packages/database migration + tooling/scripts/deploy.mjs (control step)
# Required whenever the control migration runs: `pnpm --filter @relis/database
# run migrate control`, or deploy.mjs unless run with --skip-migrate.
# packages/database/prisma/control/schema.prisma defines no models yet.
CONTROL_DATABASE_URL=postgresql://relis:changeme@localhost:5432/relis_control

# packages/database migration (project target) — only required when
# migrating a specific project database directly:
# `pnpm --filter @relis/database run migrate project`. No automated
# process supplies this today; per-project provisioning is out of scope.
# packages/database/prisma/project/schema.prisma defines no models yet.
PROJECT_DATABASE_URL=postgresql://relis:changeme@localhost:5432/relis_project_example

# --- Docker Compose — local-stack infrastructure -------------------------
# See docker-compose.yml and docs/architecture/docker-compose-stack.md.
# Every value below is a development-only placeholder; never a real
# credential. These are read by `docker compose` itself (variable
# interpolation in docker-compose.yml), NOT by @relis/config — the
# CONTROL_DATABASE_URL/PROJECT_DATABASE_URL values above describe a
# NATIVE (non-Compose) Postgres at localhost:5432; inside Compose, the
# `migrate-control`/`migrate-project` services build their own
# postgres:5432-addressed URL from the POSTGRES_* variables below instead
# of reusing the two lines above, since "postgres" only resolves inside
# the Compose network.

# PostgreSQL (one server, two disposable local databases: Control DB +
# project-test target). Not published to the host. Both databases live in
# ONE named volume (<project>_postgres-data), which survives `stop`,
# `start`, and `down` without `--volumes`.
#
# NOTE: the two database names below are only applied on a genuinely
# FIRST init, i.e. against an empty data directory. Renaming either one
# while that volume already exists does NOT create the new database —
# the image's init scripts are not re-run. Create it manually, or reset
# the volume (which destroys the existing data). See
# docs/architecture/docker-compose-stack.md
# "Persistence, lifecycle, and reset".
POSTGRES_USER=relis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=relis_control
PROJECT_TEST_DB_NAME=relis_project_example

# Reverse proxy (docker/nginx/nginx.conf) — the only published entry
# point for web + API, bound to 127.0.0.1.
NGINX_HTTP_PORT=8080

# Local mail capture (MailHog, prescribed by
# context/project-structure.md's docker/mailhog/ entry). Only its web UI
# is published (to inspect captured mail); SMTP (1025) stays internal —
# no application mail adapter exists yet to submit through it.
MAILHOG_UI_PORT=8025

# Local object storage (SeaweedFS, single-node "weed server" mode with
# its S3 gateway enabled — see docker/storage/s3-identities.json for its
# development-only access/secret key). No application storage adapter
# exists yet; this is infrastructure only.
SEAWEEDFS_S3_PORT=8333
