{
  "name": "@relis/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "pnpm --filter @relis/config build && pnpm run generate:control && tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "generate:control": "prisma generate --config prisma/control/prisma.config.ts",
    "smoke:control": "tsx scripts/control-client-smoke.mts",
    "smoke:repositories": "tsx scripts/repository-smoke.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@relis/config": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
